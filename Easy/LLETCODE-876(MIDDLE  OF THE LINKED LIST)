class Solution {
public:
    ListNode* middleNode(ListNode* head) {
        ListNode *temp=head;
        int length=0;
        while(temp!=NULL)
        {
            temp=temp->next;
            length++;
        }
        temp=head;
        for(int i=0;i<length/2;i++)
        {
            temp=temp->next;
        } 
        return temp;
    }
};
